---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import FormularioContacto from "@/components/FormularioContacto.astro";
import { SITE_TITLE } from "@/lib/consts";
import { Map, Mail, Phone } from "@/assets/icons"
---

<Layout
    title={`Contacto | ${SITE_TITLE}`}
    description="Ponte en contacto para solicitar una cotización o iniciar tu próximo proyecto digital. Cobertura en Xalapa, Veracruz y Boca del Río."
>
    <Section>
        <!-- Encabezado de la Página -->
        <div class="max-w-7xl mx-auto px-6 mb-16">
            <span class="font-mono text-xs text-(--accent) uppercase tracking-widest block mb-2">
                // Hablemos
            </span>
            <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-medium leading-[1.1] text-white mb-6">
                Contacto & Cotizaciones
            </h1>
            <p class="text-lg md:text-xl text-[#A1A1AA] font-light max-w-3xl leading-relaxed">
                ¿Tienes una idea en mente o necesitas impulsar tu presencia digital? Envíame un mensaje y conversemos sobre la mejor estrategia para tu proyecto.
            </p>
        </div>

        <!-- Layout en 2 Columnas -->
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            
            <!-- Columna 1: Formulario de Contacto -->
            <div class="lg:col-span-7">
                <FormularioContacto />
            </div>

            <!-- Columna 2: Información de contacto & Redes -->
            <div class="lg:col-span-5 space-y-8">
                
                <!-- Card de Información de Contacto -->
                <div class="bg-[#141414]/90 backdrop-blur-xl border border-white/10 rounded-2xl p-8 space-y-6 shadow-2xl">
                    <h3 class="font-display text-2xl text-white font-medium border-b border-white/10 pb-4">
                        Información Directa
                    </h3>

                    <!-- Área de Servicio -->
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-(--accent)/10 border border-(--accent)/20 flex items-center justify-center shrink-0 text-(--accent)">
                            <Map className="w-5 h-5" />
                        </div>
                        <div>
                            <span class="block font-mono text-xs text-neutral-400 uppercase tracking-wider mb-1">
                                Área de servicio
                            </span>
                            <p class="text-sm font-medium text-white">
                                Xalapa | Veracruz | Boca del Río
                            </p>
                        </div>
                    </div>

                    <!-- Teléfono / WhatsApp -->
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-(--accent)/10 border border-(--accent)/20 flex items-center justify-center shrink-0 text-(--accent)">
                            <Phone className="w-5 h-5" />
                        </div>
                        <div>
                            <span class="block font-mono text-xs text-neutral-400 uppercase tracking-wider mb-1">
                                Teléfono / WhatsApp
                            </span>
                            <a href="https://wa.me/522294009972" target="_blank" rel="noreferrer" class="text-sm font-medium text-white hover:text-(--accent) transition-colors">
                                (299) 400-9972
                            </a>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-(--accent)/10 border border-(--accent)/20 flex items-center justify-center shrink-0 text-(--accent)">
                             <Mail className="w-5 h-5" />
                        </div>
                        <div>
                            <span class="block font-mono text-xs text-neutral-400 uppercase tracking-wider mb-1">
                                Correo electrónico
                            </span>
                            <a href="mailto:emiirosgz@gmail.com" class="text-sm font-medium text-white hover:text-(--accent) transition-colors">
                                emiirosgz@gmail.com
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card de Redes Sociales -->
                <div class="bg-[#141414]/90 backdrop-blur-xl border border-white/10 rounded-2xl p-8 space-y-6 shadow-2xl">
                    <span class="font-mono text-xs text-(--accent) uppercase tracking-widest block">
                        // Conecta conmigo
                    </span>
                    <h3 class="font-display text-2xl text-white font-medium">
                        Sígueme en:
                    </h3>

                    <div class="grid grid-cols-2 gap-4">
                        <!-- LinkedIn -->
                        <a 
                            href="https://linkedin.com/in/emireth-rosas" 
                            target="_blank" 
                            rel="noreferrer"
                            class="flex items-center gap-3 p-3.5 bg-[#0A0A0A] border border-white/10 hover:border-(--accent)/50 rounded-xl transition-all duration-300 group hover:-translate-y-0.5"
                        >
                            <svg class="w-5 h-5 text-neutral-400 group-hover:text-(--accent) transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.69a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/>
                            </svg>
                            <span class="font-mono text-xs font-medium text-neutral-300 group-hover:text-white transition-colors">LinkedIn</span>
                        </a>

                        <!-- CodePen -->
                        <a 
                            href="https://codepen.io/EmirethRosas" 
                            target="_blank" 
                            rel="noreferrer"
                            class="flex items-center gap-3 p-3.5 bg-[#0A0A0A] border border-white/10 hover:border-(--accent)/50 rounded-xl transition-all duration-300 group hover:-translate-y-0.5"
                        >
                            <svg class="w-5 h-5 text-neutral-400 group-hover:text-(--accent) transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M22.25 14.37v-4.74c-.03-.13-.08-.25-.15-.36l-9.62-6.42a.96.96 0 0 0-1.06 0L1.8 9.27c-.07.11-.12.23-.15.36v4.74c.03.13.08.25.15.36l9.62 6.42c.16.11.35.17.53.17s.37-.06.53-.17l9.62-6.42c.07-.11.12-.23.15-.36zM13 5.48l7.07 4.72-3.13 2.1-3.94-2.63V5.48zm-2 0v4.21L7.06 12.3 3.93 10.2 11 5.48zM3.46 12L5.8 13.56 3.46 15.12V12zm7.54 6.52L3.93 13.8l3.13-2.1 3.94 2.63v4.19zm1-5.69l-3.28-2.19 3.28-2.19 3.28 2.19-3.28 2.19zm1 5.69v-4.19l3.94-2.63 3.13 2.1-7.07 4.72zm7.54-3.41L18.2 13.56 20.54 12v3.12z"/>
                            </svg>
                            <span class="font-mono text-xs font-medium text-neutral-300 group-hover:text-white transition-colors">CodePen</span>
                        </a>

                        <!-- Instagram -->
                        <a 
                            href="https://instagram.com/emiirosgz" 
                            target="_blank" 
                            rel="noreferrer"
                            class="flex items-center gap-3 p-3.5 bg-[#0A0A0A] border border-white/10 hover:border-(--accent)/50 rounded-xl transition-all duration-300 group hover:-translate-y-0.5"
                        >
                            <svg class="w-5 h-5 text-neutral-400 group-hover:text-(--accent) transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                            </svg>
                            <span class="font-mono text-xs font-medium text-neutral-300 group-hover:text-white transition-colors">Instagram</span>
                        </a>

                        <!-- Facebook -->
                        <a 
                            href="https://facebook.com/emiirosgz" 
                            target="_blank" 
                            rel="noreferrer"
                            class="flex items-center gap-3 p-3.5 bg-[#0A0A0A] border border-white/10 hover:border-(--accent)/50 rounded-xl transition-all duration-300 group hover:-translate-y-0.5"
                        >
                            <svg class="w-5 h-5 text-neutral-400 group-hover:text-(--accent) transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                            <span class="font-mono text-xs font-medium text-neutral-300 group-hover:text-white transition-colors">Facebook</span>
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </Section>
</Layout>
