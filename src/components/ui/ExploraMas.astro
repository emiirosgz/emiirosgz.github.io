---
import { getCollection } from "astro:content";
import { CATEGORIAS } from "@/lib/consts";
import CardRelacionado from "@/components/ui/CardRelacionado.astro";

interface Props {
  overtext: string;
  titulo: string;
}
const {overtext,titulo}  = Astro.props;

type ProyectoRelacionado = {
  href: string;
  imgSrc: string;
  titulo: string;
  categoria: string;
};

const proyectosData = await getCollection("proyectos");

function categoryHref(categoryName: string) {
  return CATEGORIAS.find((cat) => cat.id === categoryName)?.href ?? categoryName.toLowerCase().replace(/\s+/g, "-");
}

function shuffle<T>(items: T[]) {
  const result = [...items];
  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
}

const proyectos: ProyectoRelacionado[] = shuffle(proyectosData)
  .slice(0, 3)
  .map((project) => {
    const image =
      typeof project.data.imagen === "string"
        ? project.data.imagen
        : project.data.imagen?.src ?? "https://placehold.co/320x320/141414/EDEDED?text=Proyecto";
    return {
      href: `/proyectos/${categoryHref(project.data.categoria)}/${project.id}`,
      imgSrc: image,
      titulo: project.data.titulo,
      categoria: project.data.categoria,
    };
  });
---

<section class="max-w-7xl mx-auto px-6 mt-32">
  <div class="text-center mb-12">
    <p class="font-mono text-sm text-[#A1A1AA] mb-4">{overtext}</p>
    <!-- End of Project -->
    <h2 class="font-display text-2xl md:text-4xl text-white inline-flex items-center justify-center gap-4">
      {titulo}
      <!-- Explorar más trabajos -->
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
    <!-- sugerir cards aleatorios de proyectos -->
    {proyectos.map((proyecto) => (
      <CardRelacionado
        href={proyecto.href}
        imgSrc={proyecto.imgSrc}
        titulo={proyecto.titulo}
        categoria={proyecto.categoria}
      />
    ))}
  </div>
</section>
