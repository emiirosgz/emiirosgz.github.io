---
interface Props {
    etiqueta?: string;
    variante?: 
        | "uno"
        | "dos";
}
const {
    etiqueta = "tag",
    variante = "uno",
} = Astro.props;
const variantes = {
    uno: {css: "px-3 py-1 bg-(--deepgray)/80 backdrop-blur text-xs font-mono text-(--white) uppercase border border-white/10"},
    dos: {css: "px-2 py-1 bg-(--black)/70 border border-white/5 rounded-sm text-[10px] font-mono text-(--lightgray) uppercase"}
}
const style = variantes[variante];
---
<div class={style.css}>
  {etiqueta && <span>{etiqueta}</span>}
</div>