---
import { Image } from "astro:assets";
import { resolveImage } from "@/lib/utils";

const {
    Icon, titulo, descripcion, lista, wh, imgSrc, alt
} = Astro.props;

const imageAsset = resolveImage(imgSrc);
---
<div class="group cursor-pointer">
    <div class="relative w-full aspect-4/3 bg-surface overflow-hidden">
        <Image
            src={imageAsset}
            alt={alt || titulo || "Servicio"}
            loading="lazy"
            decoding="async"
            width={600}
            height={450}
            quality={80}
            layout='constrained'
            class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-700 ease-in-out"
        />
    </div>
<div class="bg-(--c-gray-950)/80 border border-white/5 p-8 hover:border-white/20 hover:bg-neutral-800/30 transition-colors">
    <div class="w-12 h-12 bg-white/5 rounded-none flex items-center justify-center mb-6">
        {Icon && <Icon className="group-hover:stroke-(--accent)" width={wh} height={wh} />}
    </div>
    <h3 class="font-display text-xl font-medium mb-3">
        {titulo}
    </h3>
    <p class="text-(--c-gray-400) text-sm mb-6 leading-relaxed">
        {descripcion}
    </p>
    <ul class="text-(--c-gray-400) text-sm font-mono space-y-2 list-line">
        {lista.map((item:any) =>(
            <li>{item}</li>
        ))}
    </ul>
</div>
</div>