---
interface Props {
  href?: string;
  imgSrc?: string;
  titulo?: string;
  categoria?: string;
  alt?: string;
}
const {
  href = "#",
  imgSrc = "https://placehold.co/320x320/141414/EDEDED?text=Proyecto",
  titulo = "Proyecto Relacionado",
  categoria = "Proyecto",
  alt = "Miniatura de proyecto",
} = Astro.props;
---

<a href={href} class="group block overflow-hidden border border-white/10 bg-(--deepgray) transition-transform duration-300 hover:-translate-y-2 hover:border-(--accent)/60">
  <div class="aspect-4/3 overflow-hidden bg-(--deepgray)">
    <img src={imgSrc} alt={alt} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
  </div>
  <div class="p-4">
    <p class="text-[11px] uppercase tracking-[0.3em] text-[#A1A1AA] mb-2">{categoria}</p>
    <h3 class="font-display text-lg font-medium text-white group-hover:text-(--accent)  transition-colors leading-tight">{titulo}</h3>
  </div>
</a>
