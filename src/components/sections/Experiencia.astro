---
import InfoExpe from "./TituloSeccion.astro";
import ExEmpleo from "../ui/BloqueExperiencia.astro";
import {ExperienciaInfo as expeInfo} from "@/lib/consts"
---
<div class="max-w-4xl mx-auto px-6 mb-24">
    <InfoExpe titulo="Experiencia" en="Experience"/>
   {expeInfo.map((expe) => (
       <ExEmpleo 
            puesto={expe.puesto}
            empresa={expe.empresa}
            inicio={expe.fechaInicio}
            fin={expe.fechaFin}
            desc={expe.descripcion}/>
   ))}
</div>
