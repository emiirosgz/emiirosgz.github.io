---
import InfoDestacado from "./TituloSeccion.astro";
import Tags from '@/components/ui/Tags.astro'
import Card from "../ui/Card.astro";
import CTA from '@/components/sections/CTA.astro'
import Section from "../ui/Section.astro";
---
 <Section id="proyectos" class="max-w-7xl mx-auto px-6 mb-24 lg:mb-32 clear-end">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
        <div class="group lg:col-span-12 block">
            <!-- titulo -->
            <InfoDestacado titulo="Destacados" numero="01" en="Selected Work"/>
            
            <!-- proyecto destacado -->
            <a href="#" class="">
                <div class="relative w-full aspect-video lg:aspect-21/9 bg-surface overflow-hidden mb-6 border border-white/5">
                    <!-- Placeholder Image - In real life, use Next/Astro optimized images -->
                    <img src="https://placehold.co/1200x600/141414/EDEDED?text=Internal+Gantt+Tracker" alt="Internal Gantt Tracker" class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-700 ease-in-out">
                </div>
                <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                    <div>
                        <h3 class="text-2xl md:text-3xl font-medium mb-2 group-hover:text-(--accent) transition-colors">Internal Gantt Tracker</h3>
                        <p class="text-textMuted max-w-xl">Desarrollo de una solución web local para visualización de timelines y gestión de recursos internos, reduciendo la fricción operativa.</p>
                    </div>
                    <div class="flex flex-wrap gap-2 text-xs font-mono text-textMuted uppercase">
                    <Tags etiqueta="Web App" variante="uno"/>
                    <Tags etiqueta="UI Design" variante="uno"/>
                    <Tags etiqueta="Logic" variante="uno"/>
                    </div>
                </div>
            </a>
        </div>
        <div class="group lg:col-span-6 block mt-12 lg:mt-0">
            <Card
                href="#"
                imgSrc="https://placehold.co/800x600/141414/A1A1AA?text=Content+Proyect"
                titulo="Demo Card Simple"
                descripcion=""
                alt="demo"
                variante="simple"
            />
        </div>
        <div class="group lg:col-span-6 block mt-12 lg:mt-0 lg:pt-24">
            <Card
                href="#"
                imgSrc="https://placehold.co/800x600/141414/A1A1AA?text=Content+Proyect"
                titulo="Demo Card Simple"
                descripcion=""
                alt="demo"
                variante="simple"
            />
        </div>
    </div>

    <CTA
        titulo="Ver más proyectos"
        desc="Conoce los proyectos personales enfocados en webapps y sitios web modernos, explorando nuevas tecnologías, buenas prácticas y experiencias interactivas. Estos proyectos reflejan mi interés por la innovación, el diseño funcional y la creación de soluciones digitales escalables."
        href="/proyectos"
        etiqueta="ver proyectos"
    />

 </Section>