---
import { getCollection } from "astro:content";
import InfoDestacado from "./TituloSeccion.astro";
import Tags from "@/components/ui/Tags.astro";
import Card from "../ui/Card.astro";
import CTA from "@/components/sections/CTA.astro";
import Section from "../ui/Section.astro";
import { getCategoryHref, resolveImage } from "@/lib/utils";
import { Image } from "astro:assets";
import fallbackImg from "@/assets/fallback-emiirosgz.webp";

// Obtener la colección de proyectos
const allProjects = await getCollection("proyectos");

// Ordenar proyectos por año descendente
const sortedProjects = [...allProjects].sort((a, b) => (b.data.anno ?? 0) - (a.data.anno ?? 0));

// 1. Filtrar proyectos propios
const projects = await getCollection("proyectos");

// 1. Proyecto Destacado Principal (Proyectos Propios)
const mainProject = projects.find((p) => p.data.esDestacado);

// 2. Proyectos Secundarios (Work - max 2)
const secondaryProjects = projects
    .filter((p) => p.id !== mainProject?.id)
    .slice(0, 2);

const getImgSrc = (imgProp: any) => resolveImage(imgProp) || fallbackImg;
---

<Section id="proyectos" class="max-w-7xl mx-auto px-6 mb-24 lg:mb-32 clear-end">
    <!-- Encabezado de la Sección -->
    <InfoDestacado titulo="Destacados" en="Selected Work" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-12">
        {/* Proyecto Principal (Proyectos Propios) */}
        {mainProject && (
            <div class="group lg:col-span-12 block">
                <a href={basePath(`/proyectos/${getCategoryHref(mainProject.data.categoria)}/${mainProject.id}`)} class="block group">
                    <div class="relative w-full aspect-video lg:aspect-21/9 bg-surface overflow-hidden mb-6 border border-white/10 rounded-2xl">
                        <Image 
                            src={getImgSrc(mainProject.data.imagen)} 
                            alt={mainProject.data.titulo} 
                            loading="lazy"
                            decoding="async"
                            width={1200}
                            height={675}
                            quality={80}
                            class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-700 ease-in-out"
                        />
                        <div class="absolute top-4 left-4 bg-black/80 backdrop-blur-md border border-white/15 px-3.5 py-1.5 rounded-full font-mono text-xs text-(--accent) uppercase tracking-wider shadow-lg">
                            // {mainProject.data.categoria}
                        </div>
                    </div>
                    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                        <div>
                            <h3 class="text-2xl md:text-3xl font-medium mb-2 group-hover:text-(--accent) transition-colors">
                                {mainProject.data.titulo}
                            </h3>
                            <p class="text-textMuted max-w-2xl text-base leading-relaxed font-light">
                                {mainProject.data.short_desc}
                            </p>
                        </div>
                        <div class="flex flex-wrap gap-2 text-xs font-mono text-textMuted uppercase shrink-0">
                            {mainProject.data.tags?.map((tag: string) => (
                                <Tags etiqueta={tag} variante="uno" />
                            ))}
                        </div>
                    </div>
                </a>
            </div>
        )}

        {/* 2 Proyectos Secundarios (sin repetir) */}
        {secondaryProjects.map((project) => (
            <div class="group lg:col-span-6 block mt-4 lg:mt-0">
                <Card
                    href={`/proyectos/${getCategoryHref(project.data.categoria)}/${project.id}`}
                    imgSrc={getImgSrc(project.data.imagen)}
                    titulo={project.data.titulo}
                    descripcion={project.data.short_desc}
                    tags={project.data.tags}
                    alt={project.data.titulo}
                    variante="simple"
                />
            </div>
        ))}
    </div>

    <CTA
        titulo="Ver más proyectos"
        desc="Conoce los proyectos personales y de clientes enfocados en webapps y sitios web modernos, explorando nuevas tecnologías, buenas prácticas y experiencias interactivas."
        href="/proyectos"
        etiqueta="Ver todos los proyectos"
    />
</Section>