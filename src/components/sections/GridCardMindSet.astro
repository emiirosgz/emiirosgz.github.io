---
import InfoMindSet from "./TituloSeccion.astro";
import Card from "../ui/CardMindSet.astro";
import { Servicios as MindSet } from "@/lib/consts";
import CTA from '@/components/sections/CTA.astro'
---

<section id="skills" class="py-10 mb-24 lg:mb-32 bg-(--c-green-900)">
    <div class="max-w-7xl mx-auto px-6 pt-16">
        <!-- titulo -->
        <InfoMindSet titulo="Servicios" numero="02" en="Mindset" />
    
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                MindSet.map((info) => (
                    <div class="">
                        <a href={`/servicios/${info.id}`}>

                            <Card
                                imgSrc={info.img}
                                alt={info.titulo}
                                Icon={info.icon}
                                titulo={info.titulo}
                                descripcion={info.descripcion}
                                lista={info.lista}
                                wh="24px"
                            />
                        </a>
                    </div>
                ))
            }
        </div>
        <CTA
            titulo="¿Cómo podemos trabajar juntos?"
            desc="Antes de hablar de propuestas o presupuestos, te explico cómo se desarrolla cada proyecto, qué puedes esperar durante el proceso y cómo se realiza la entrega."
            href="/clientes"
            etiqueta="Ver proceso de trabajo"
        />
    </div>
</section>
