---
interface Props {
    titulo: string;
    en?:string;
    className?:string;
}
const { titulo, en, className} = Astro.props;
---

<div class=`${className} flex justify-between items-end mb-16 border-b border-white/10 pb-8`>
    <h2 class="font-display text-3xl md:text-4xl font-medium">{titulo}</h2>
    <span class="text-textMuted font-mono text-sm hidden md:block"
        >// {en}</span
    >
</div>
