---
import Cookie from "@/assets/imgs/cookie.png";
import { Image } from "astro:assets";
import { basePath } from "@/lib/utils";
---

<div 
    id="cookie-banner" 
    class="fixed bottom-4 left-4 right-4 md:left-auto md:right-6 md:max-w-md z-50 transform translate-y-0 opacity-100 transition-all duration-500 ease-out hidden"
    role="dialog"
    aria-live="polite"
    aria-label="Aviso de cookies"
>
    <div class="bg-[#141414]/95 backdrop-blur-xl border border-white/15 rounded-2xl p-5 shadow-2xl shadow-black/80 space-y-4">
        <div class="flex items-start gap-3">
            <div class="p-2 bg-white/5 rounded-xl border border-white/10 text-xl shrink-0">
               <Image src={Cookie} alt="Cookie" width="24" height="24"/>
                <!-- 🍪 -->
            </div>
            <div class="space-y-1">
                <h3 class="font-display text-sm font-medium text-white">
                    Respeto tu privacidad...
                </h3>
                <p class="text-xs text-[#A1A1AA] font-light leading-relaxed">
                    Preguntandote si quieres cookies, pero reafirmo mi autoridad haciendote aceptarlas de todas formas.
                </p>
                <p class="text-xs text-[#A1A1AA] font-light leading-relaxed">
                    Utilizo cookies sencillas para entender cómo navegas en mi portafolio y mejorar tu experiencia. Nada de spam ni datos invasivos. Puedes leer más en el <a href={basePath("/aviso-privacidad")} class="text-(--accent) underline hover:text-white transition-colors">Aviso de Privacidad</a>.
                </p>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-white/10">
            <button 
                id="btn-aceptar-cookies"
                type="button"
                class="w-full sm:w-auto bg-(--accent) hover:bg-(--accent)/90 text-black font-medium text-xs px-5 py-2.5 rounded-xl transition-all duration-200 cursor-pointer shadow-lg shadow-(--accent)/10 active:scale-95 text-center"
            >
                Entendido / Aceptar
            </button>
        </div>
    </div>
</div>

<script is:inline>
    function initCookieBanner() {
        const banner = document.getElementById('cookie-banner');
        const btnAceptar = document.getElementById('btn-aceptar-cookies');

        if (!banner || !btnAceptar) return;

        // Evitar duplicar listeners en Astro
        if (btnAceptar.dataset.initialized === 'true') return;
        btnAceptar.dataset.initialized = 'true';

        // 1. Verificar preferencia en localStorage
        const consent = localStorage.getItem('cookie_consent');

        if (consent === 'granted') {
            banner.classList.add('hidden');
        } else {
            banner.classList.remove('hidden');
        }

        // 2. Conectar botón de Aceptar
        btnAceptar.addEventListener('click', () => {
            // Guardar preferencia
            localStorage.setItem('cookie_consent', 'granted');

            // Actualizar estado en Google Analytics (Consent Mode v2)
            if (typeof window.gtag === 'function') {
                window.gtag('consent', 'update', {
                    'analytics_storage': 'granted',
                    'ad_storage': 'granted',
                    'ad_user_data': 'granted',
                    'ad_personalization': 'granted'
                });
            }

            // Ocultar banner con animación
            banner.classList.add('opacity-0', 'translate-y-4');
            setTimeout(() => {
                banner.classList.add('hidden');
            }, 500);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCookieBanner);
    } else {
        initCookieBanner();
    }
    document.addEventListener('astro:page-load', initCookieBanner);
</script>
