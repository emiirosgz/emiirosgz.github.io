---
import { ChevronDown } from '@/assets/icons';

interface Props {
    tituloBoton?: string;
}

const { tituloBoton = "Leer más: Sistema de Diseño (Tipografía & Colores)" } = Astro.props;
---

<div class="my-16">
    <!-- Divisor Visual con Botón Interactivo de Leer Más -->
    <div class="relative flex items-center justify-center my-12">
        <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-white/10"></div>
        </div>
        <button
            id="toggle-diseno-btn"
            type="button"
            class="relative z-10 px-6 py-3 rounded-full bg-[#141414] border border-white/15 hover:border-(--accent) text-white hover:text-(--accent) font-display font-medium text-sm transition-all duration-300 shadow-xl flex items-center gap-3 group cursor-pointer"
            aria-expanded="false"
            aria-controls="seccion-diseno-container"
        >
            <span class="w-2 h-2 rounded-full bg-(--accent) animate-ping"></span>
            <span id="toggle-diseno-label">{tituloBoton}</span>
            <div id="toggle-diseno-icon" class="transition-transform duration-500">
                <ChevronDown width="18" height="18" />
            </div>
        </button>
    </div>

    <!-- Contenedor desplegable (Oculto por defecto con transition suave) -->
    <div 
        id="seccion-diseno-container" 
        class="hidden opacity-0 translate-y-4 transition-all duration-700 ease-in-out"
    >
        <slot />
    </div>
</div>

<script>
    function setupToggleSeccionDiseno() {
        const btn = document.getElementById('toggle-diseno-btn');
        const container = document.getElementById('seccion-diseno-container');
        const label = document.getElementById('toggle-diseno-label');
        const icon = document.getElementById('toggle-diseno-icon');

        if (!btn || !container || !label || !icon) return;

        let isOpen = false;

        btn.addEventListener('click', () => {
            isOpen = !isOpen;

            if (isOpen) {
                container.classList.remove('hidden');
                // Trigger reflow to enable transition
                void container.offsetWidth;
                container.classList.remove('opacity-0', 'translate-y-4');
                container.classList.add('opacity-100', 'translate-y-0');

                label.textContent = "Ocultar información (Tipografía & Colores)";
                icon.classList.add('rotate-180');
                btn.setAttribute('aria-expanded', 'true');
            } else {
                container.classList.remove('opacity-100', 'translate-y-0');
                container.classList.add('opacity-0', 'translate-y-4');

                setTimeout(() => {
                    if (!isOpen) {
                        container.classList.add('hidden');
                    }
                }, 500);

                label.textContent = "Leer más: Sistema de Diseño (Tipografía & Colores)";
                icon.classList.remove('rotate-180');
                btn.setAttribute('aria-expanded', 'false');

                // Smooth scroll back to toggle divider when closing
                btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupToggleSeccionDiseno);
    } else {
        setupToggleSeccionDiseno();
    }
    document.addEventListener('astro:page-load', setupToggleSeccionDiseno);
</script>
