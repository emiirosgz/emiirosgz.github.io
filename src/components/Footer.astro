---
import ScriptFooter from "./ScriptFooter.astro";
import { FooterLinks } from "@/lib/consts";
import { basePath } from "@/lib/utils";

---
<footer
      class="bg-(--deepgray) border-t border-white/5 pt-24 pb-12 transition-all duration-700 ease-out"
    >
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-24">
          <div>
            <h2 class="font-display text-4xl md:text-5xl font-medium mb-8 leading-tight">
              Construyamos algo estructurado y hermoso.
            </h2>
            <p class="text-(--lightgray)  text-lg max-w-md leading-relaxed">
              Actualmente estoy aceptando proyectos. Envíeme un correo electrónico y me comunicaré contigo lo antes posible. Estaré encantada de conversar, conocer tu marca y ver cómo puedo ayudar.
            </p>
          </div>
          <div class="lg:text-right flex flex-col lg:items-end justify-center">
            <p class="font-mono text-sm text-(--lightgray) mb-4 uppercase tracking-wider">
                ¿Tienes un proyecto?
            </p>
            <a
              href="mailto:emiirosgz@gmail.com"
              class="font-display text-3xl md:text-5xl font-medium border-b-2 border-transparent hover:border-(--accent) transition-colors inline-block pb-2"
            >
              emiirosgz@gmail.com
            </a>
          </div>
        </div>
 
        <div class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-white/10 text-sm text-(--lightgray) font-mono">
          <p>© 2026 emiirosgz, made with 💚 and Coffee ☕</p>
          <div class="flex flex-wrap gap-4 sm:gap-6 mt-4 md:mt-0 justify-center">

            { FooterLinks.map((link) => (
              <a 
                href={basePath(link.href)} 
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                class="hover:text-white transition-colors"
              >
                {link.label}
              </a>
            ))
            }
            
          </div>
          <p class="mt-4 md:mt-0 hidden lg:block text-right">
            Xalapa, Ver, México (CST)
          </p>
        </div>
      </div>
      <!-- texto centrado en grande con opacidad al 30% -->
      <div class="w-full max-w-7xl mx-auto overflow-hidden md:h-80 font-display text-center px-0">
        <span class="w-full mx-0 text-[5rem] md:text-[14.33rem] text-nowrap tracking-tight font-bold text-(--lightgray) opacity-30 select-none pointer-events-none">
          Emii Rosgz <span class="text-(--accent)">.</span>
        </span>
      </div>
      <ScriptFooter/>
</footer>