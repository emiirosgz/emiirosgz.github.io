---
import Layout from "./Layout.astro";
import Section from "@/components/ui/Section.astro";
import BackTo from "@/components/ui/BackToHome.astro";
import {CheckCircle, Globe, Layers, Code} from '@/assets/icons'

const { frontmatter } = Astro.props;
const wh = "20px"
const wt = "24px"

if (frontmatter.titulo.includes("Diseño") || frontmatter.titulo.includes("Experiencia")){
    frontmatter.icon = Layers;
} else if (frontmatter.titulo.includes("Estrategia") || frontmatter.titulo.includes("Contenido")) {
    frontmatter.icon = Globe;
} else if (frontmatter.titulo.includes("Code") || frontmatter.titulo.includes("Build")) {
    frontmatter.icon = Code;
} else {
    frontmatter.icon = Code;
}
---

<Layout title={frontmatter.titlePage} description={frontmatter.descPage}>
    <Section>
        <BackTo label="Servicios" href="/servicios" />
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-8">
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-14 h-14 bg-[#141414] border border-white/10 flex items-center justify-center animate-float">
                        {(() => {
                            const Icon = frontmatter.icon;
                            return <Icon className="" width={wt} height={wt} />;
                        })()}
                    </div>
                </div>
                <h1
                    class="font-display text-4xl md:text-6xl lg:text-7xl font-medium leading-[1.1] mb-6"
                >
                    {frontmatter.titulo}
                </h1>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 mb-24">
            <div class="lg:col-span-7 slide-up-fade">
                <h2 class="font-display text-2xl mb-6 text-(--accent)">
                    El Enfoque
                </h2>
                <p class="text-lg md:text-xl text-[#A1A1AA] leading-relaxed mb-12 font-light">
                    {frontmatter.long_desc}
                </p>
                <h3 class="font-display text-xl mb-6 border-b border-white/10 pb-4">
                    Lo que obtienes:
                </h3>
                <ul class="space-y-6">
                    {frontmatter.beneficio.map((item:string) => (
                        <li class="flex items-start gap-4 text-[#EDEDED] bg-[#141414] p-4 border border-white/5" >
                            <CheckCircle className="text-(--accent) shrink-0 mt-0.5" width={wh} height={wh}/>
                            <span class="leading-relaxed">
                                {item}
                            </span>
                        </li>
                    )) }
                </ul>
            </div>
            <div class="lg:col-span-5 slide-up-fade delay-200">
                <div class="w-full aspect-2/3 bg-[#141414] border border-white/5 overflow-hidden sticky top-32  rounded-xl">
                    <img src={frontmatter.img} alt={frontmatter.titulo}class="w-full h-full object-cover"/>    
                    <div class="absolute inset-0 bg-linear-to-t from-[#0C0C0C] from-10% via-[#0C0C0C]/20 via-30% to-transparent" >
                    </div>
                    <div class="absolute inset-0 flex flex-col justify-end p-8">
                        <h4 class="font-mono text-sm text-[#EA580C] uppercase tracking-wider mb-2">
                            // Capacidades
                        </h4>
                        <div class="flex flex-wrap gap-2">
                            {frontmatter.capacidades.map((item:string) => (
                                <span class="px-3 py-1.5 bg-white/10 backdrop-blur-md border border-white/20 text-xs font-mono text-white">
                                    {item}
                                </span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>   
    </Section>
</Layout>
